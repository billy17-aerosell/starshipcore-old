{
  "rewrites": [
    {
      "source": "/api/mobile-whitelist-manager",
      "destination": "/api/whitelist-manager?platform=mobile"
    },
    {
      "source": "/api/mobile-bootstrap",
      "destination": "/api/bootstrap?platform=mobile"
    },
    {
      "source": "/api/auth-check-x7p4",
      "destination": "/api/load?platform=mobile"
    },
    {
      "source": "/api/get-mobile-loader",
      "destination": "/api/get-loader?platform=mobile"
    },
    {
      "source": "/protected/(.*)",
      "destination": "/404"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
