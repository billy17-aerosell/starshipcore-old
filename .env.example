# Environment Variables Template

# Admin secret for key management API
# CHANGE THIS to a strong, random password before deploying!
ADMIN_SECRET=932885a21f402ed282d420a55e742b52cf11eae0b3d4e6280fcb7647b4860049

# Discord Webhook URL for real-time access logging
# Get this from Discord: Server Settings > Integrations > Webhooks > New Webhook
# Example: https://discord.com/api/webhooks/1234567890/abcdef...
DISCORD_WEBHOOK_URL=

# Discord Webhook URL for STATUS CHANNEL updates (optional)
# This sends embed messages when status changes
# Example: https://discord.com/api/webhooks/1234567890/xyz...
DISCORD_STATUS_WEBHOOK_URL=

# Discord STATUS CHANNEL ID for live channel name update
# Create a voice channel, right-click > Copy Channel ID
# The channel name will change to: 🔒 🟢 | LIVE, 🔒 🟠 | MAINTENANCE, etc.
# Requires DISCORD_BOT_TOKEN to be set
DISCORD_STATUS_CHANNEL_ID=

# Optional: Set to production when deploying
NODE_ENV=production

# ═══════════════════════════════════════════════════════════════════
# SECURITY v3.0: HMAC Signing Key
# ═══════════════════════════════════════════════════════════════════
# IMPORTANT: Change this to a random 64+ character string
# This key MUST match the one in Loader.lua and mobile-loader.lua
# Generate with: openssl rand -hex 32
STARSHIP_SECRET_KEY=538739a817cc0c94cefd894f83fd6e0e074d435d3153b85f345d461d55d2ec1c

# ═══════════════════════════════════════════════════════════════════
# MODULE BUNDLE ENCRYPTION KEY
# ═══════════════════════════════════════════════════════════════════
# CRITICAL: This key is used to decrypt the module bundle (pc.json)
# Get this value from: cdn-bundle/bundle-key.txt after running:
#   node tools/generate-bundle.js
# If this doesn't match the bundle, you'll get "Invalid server key" error
BUNDLE_KEY=
